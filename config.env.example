# Legacy environment example retained for users migrating older local wrappers.
#
# New acore-manager scripts load config/defaults/manager.conf.example plus
# config/local/manager.conf. Runtime must use /opt/acore-manager/current, not
# build/staging.

ACM_ROOT="/opt/acore-manager"
ACORE_REPO="https://github.com/azerothcore/azerothcore-wotlk.git"
ACORE_BRANCH="master"
ACORE_USER="azerothcore"
ACORE_GROUP="azerothcore"

AUTH_SERVICE="azerothcore-auth.service"
WORLD_SERVICE="azerothcore-world.service"

DATADIR="/opt/acore-manager/shared/data"
CONFIG_DIR="/opt/acore-manager/shared/configs"
BUILD_TYPE="RelWithDebInfo"
BUILD_THREADS="auto"
CMAKE_EXTRA_FLAGS=""

# Active runtime path:
# /opt/acore-manager/current -> /opt/acore-manager/releases/<release>
