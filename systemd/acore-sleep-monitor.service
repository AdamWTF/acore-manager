# Generic acore-manager idle sleep monitor service template.

[Unit]
Description=acore-manager Idle Sleep Monitor
After=network-online.target azerothcore-auth.service azerothcore-world.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/acore-manager/scripts/power/acore-sleep-monitor.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
