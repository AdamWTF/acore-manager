# Generic acore-manager idle sleep auth proxy service template.

[Unit]
Description=acore-manager Idle Sleep Auth Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/acore-manager/scripts/power/acore-sleep-proxy.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
