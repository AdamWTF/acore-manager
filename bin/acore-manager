#!/usr/bin/env bash
set -Eeuo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"

usage() {
  cat <<EOF
Usage:
  acore-manager docker <command> [args...]

Docker commands:
  validate             Validate Docker manager config and local tools
  sync-modules         Clone/update AzerothCore and configured modules
  build                Generate overrides and run docker compose build
  db-import            Run the db-import service
  up                   Start authserver/worldserver and database when local
  down                 Stop the Compose deployment
  logs <service>       Follow logs for a Compose service
  shell <service>      Open a shell in a running service container
EOF
}

die() {
  echo "Error: $*" >&2
  echo >&2
  usage >&2
  exit 1
}

script_for_docker_command() {
  case "$1" in
    validate) echo "scripts/docker/acore-docker-validate.sh" ;;
    sync-modules) echo "scripts/docker/acore-docker-sync-modules.sh" ;;
    build) echo "scripts/docker/acore-docker-build.sh" ;;
    db-import) echo "scripts/docker/acore-docker-db-import.sh" ;;
    up) echo "scripts/docker/acore-docker-up.sh" ;;
    down) echo "scripts/docker/acore-docker-down.sh" ;;
    logs) echo "scripts/docker/acore-docker-logs.sh" ;;
    shell) echo "scripts/docker/acore-docker-shell.sh" ;;
    *) return 1 ;;
  esac
}

if [[ "$#" -eq 0 ]]; then
  usage
  exit 1
fi

scope="$1"
shift

case "$scope" in
  help|-h|--help)
    usage
    exit 0
    ;;
  docker)
    ;;
  *)
    die "unknown scope: $scope"
    ;;
esac

if [[ "$#" -eq 0 ]]; then
  usage
  exit 1
fi

command_name="$1"
shift

case "$command_name" in
  help|-h|--help)
    usage
    exit 0
    ;;
esac

script_relative="$(script_for_docker_command "$command_name")" || die "unknown docker command: $command_name"
script_path="$REPO_ROOT/$script_relative"

if [[ ! -f "$script_path" ]]; then
  die "docker command '$command_name' maps to a missing script: $script_relative"
fi

set -- "$@"
# shellcheck disable=SC1090
source "$script_path"
